# GEMINI_API_KEY: Required if optional AI insights are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret key used to sign session tokens (change in production).
SESSION_SECRET="change-this-to-a-long-random-secret"

# ADMIN_EMAIL / ADMIN_PASSWORD: Optional initial Super Admin bootstrap credentials.
# If omitted, the /admin/setup screen lets you create the first admin securely in-browser.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# SMTP Configuration (Optional - for real email verification & admin alerts)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Pouria Business Cloud <no-reply@example.com>"
